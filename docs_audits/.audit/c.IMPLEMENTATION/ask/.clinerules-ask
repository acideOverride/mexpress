# Communication Guidelines
business_vocabulary:
  allowed_terms:
    - business capabilities
    - value propositions
    - market opportunities
    - stakeholder needs
    - growth potential
    - success criteria
    - business value
    - market alignment

  prohibited_terms:
    - API
    - Database
    - Framework
    - Implementation
    - Code
    - Technical
    - Development
    - Programming

