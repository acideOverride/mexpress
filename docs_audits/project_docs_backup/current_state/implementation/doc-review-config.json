{
  "documentationInfrastructure": {
    "version": "1.0.0",
    "environment": "production",
    "tools": {
      "docTesting": {
        "framework": "jest",
        "coverageThresholds": {
          "unit": 90,
          "integration": 85,
          "e2e": 80,
          "criticalPaths": 100
        },
        "reporters": [
          "json",
          "html",
          "text"
        ],
        "outputPath": "/opt/mExpress/docs/implementation/reports"
      },
      "validationSystem": {
        "linters": {
          "markdown": {
            "enabled": true,
            "config": "standard"
          },
          "javascript": {
            "enabled": true,
            "config": "eslint:recommended"
          },
          "typescript": {
            "enabled": true,
            "config": "@typescript-eslint/recommended"
          }
        },
        "validators": {
          "links": {
            "enabled": true,
            "checkExternal": true
          },
          "codeExamples": {
            "enabled": true,
            "runTests": true
          },
          "apiDocs": {
            "enabled": true,
            "validateSchema": true
          }
        }
      },
      "metricsTracking": {
        "collectors": {
          "coverage": {
            "enabled": true,
            "threshold": 95
          },
          "quality": {
            "enabled": true,
            "threshold": 90
          },
          "completeness": {
            "enabled": true,
            "threshold": 100
          }
        },
        "reporting": {
          "format": "json",
          "interval": "daily",
          "retention": "90d"
        }
      },
      "workflowAutomation": {
        "git": {
          "branchNaming": "docs/BRQ-YEAR-NUMBER",
          "commitTemplate": "docs(scope): description",
          "requireReview": true
        },
        "ci": {
          "runTests": true,
          "validateLinks": true,
          "checkCoverage": true,
          "generateReports": true
        },
        "notifications": {
          "slack": {
            "enabled": true,
            "channel": "doc-reviews"
          },
          "email": {
            "enabled": true,
            "recipients": "doc-team@mexpress.dev"
          }
        }
      }
    },
    "accessControl": {
      "roles": {
        "docTeam": {
          "permissions": ["read", "write", "review"],
          "scope": "all"
        },
        "reviewer": {
          "permissions": ["read", "review"],
          "scope": "assigned"
        },
        "developer": {
          "permissions": ["read", "comment"],
          "scope": "technical"
        }
      }
    },
    "auditConfig": {
      "enabled": true,
      "frequency": "weekly",
      "metrics": [
        "coverage",
        "quality",
        "completeness",
        "accuracy"
      ],
      "reporting": {
        "format": "html",
        "distribution": "team-leads"
      }
    }
  }
}