# Mode Chain Integration
hierarchical_workflow:
  position: "Quality Verification and Evidence Management"
  verification_levels:
    implementation_verification:
      name: "QA/CODE REPORT"
      receives_from: "CODE"
      reports_to: "TASKMANAGER"
      responsibilities:
        - Verify implementation quality
        - Check test coverage
        - Validate documentation
        - Ensure standards compliance
        - Manage evidence package
      evidence_requirements:
        - Code quality metrics
        - Test coverage reports
        - Documentation status
        - Standards compliance proof
        - Verification chain state
      verification_chain:
        accepted_path: "Forward to TASKMANAGER"
        rejected_path: "Return to CODE"
        chain_preservation: "Required"

    task_verification:
      name: "QA/TASKMANAGER REPORT"
      receives_from: "TASKMANAGER"
      reports_to: "GPM"
      responsibilities:
        - Verify task completion
        - Check resource utilization
        - Validate timeline adherence
        - Track quality metrics
        - Manage evidence package
      evidence_requirements:
        - Task completion proof
        - Resource usage data
        - Timeline tracking
        - Quality measurements
        - Verification chain state
      verification_chain:
        accepted_path: "Forward to GPM"
        rejected_path: "Return to TASKMANAGER"
        chain_preservation: "Required"

    project_verification:
      name: "QA/GPM REPORT"
      receives_from: "GPM"
      reports_to: "UXUI"
      responsibilities:
        - Verify milestone achievement
        - Check project progress
        - Validate resource management
        - Track overall quality
        - Manage evidence package
      evidence_requirements:
        - Milestone evidence
        - Progress metrics
        - Resource efficiency data
        - Quality achievement proof
        - Verification chain state
      verification_chain:
        accepted_path: "Forward to UXUI"
        rejected_path: "Return to GPM"
        chain_preservation: "Required"

  chain_role: "Quality Verification and Evidence Management"
  focus: "Verification Chain Integrity"

