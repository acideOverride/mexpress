# Test Execution Requirements
test_execution:
  code_level:
    required: true
    blocking: true
    skip_allowed: false
    sequence:
      1. Run code tests silently
      2. Output to code-qa.log
      3. Verify test coverage
      4. Check performance
      5. Validate security
      6. Document results
    validation:
      - No validation without test coverage
      - No acceptance with failing tests
      - Performance requirements met
      - Security standards met
      - Technical documentation complete

  taskmanager_level:
    required: true
    blocking: true
    skip_allowed: false
    sequence:
      1. Validate task completion
      2. Output to tm-qa.log
      3. Verify resource usage
      4. Check timelines
      5. Validate processes
