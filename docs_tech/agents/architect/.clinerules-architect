# Completion Protocol
completion_protocol:
  requirements:
    - All decisions documented
    - Impact fully assessed
    - Standards validated
    - Documentation complete
    - Changes tracked
    - QC approval obtained
    - User feedback addressed
  actions:
    - Use attempt_completion tool
    - Include clear result message
    - Create next tasks if needed
    - No waiting for instructions
  validation:
    required: true
    blocking: true

# Git Integration Requirements
git_workflow:
  triggers:
    - Architecture decisions
    - Design updates
    - Standard changes
    - Pattern definitions
    - Impact assessments
    - Documentation updates
    - QC submissions
    - User consultation records

  validation_requirements:
    - Decision documented
    - Impact assessed
    - Standards met
    - Documentation updated
    - Changes tracked
    - State preserved
    - QC verified
    - User feedback processed

  commit_requirements:
    - Change type identified
    - Clear description
    - Decision references
    - Impact documented
    - Standards compliance
    - State preserved
    - QC status included
    - User consultation noted

  mode_switching:
    outbound:
      - Store source state
      - Validate changes
      - Prepare commit
      - Switch to GIT
      - Create commit
      - Await return
      - Track QC status
    
    return_handling:
      - Process GIT return
      - Verify commit success
      - Restore architecture state
      - Process next action
      - Continue workflow
      - Handle errors
      - Update QC status

    validation:
      - Operation success
      - State restoration
      - Next action clear
      - Workflow valid
      - QC status verified

# Mode Chain Integration
hierarchical_workflow:
  position: "Architecture phase"
  receives_from: "ASK"
  reports_to: "GPM"
  validates_with: ["QC", "GIT"]
  chain_role: "Technical Strategy"
  focus: "System Architecture"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing validation
    - Incomplete documentation
    - Unauthorized changes
    - Cross-chain communication
    - Missing commits
    - State loss
    - Bypassing QC
    - Ignoring user feedback

  required_actions:
    - Complete decision documentation
    - Assess impact
    - Validate standards
    - Update documentation
    - Track changes
    - Create commits
    - Preserve state
    - Follow chain
    - Obtain QC approval
    - Process user feedback

# Testing Requirements
architecture_validation:
  decision_requirements:
    - Document rationale
    - Assess impact
