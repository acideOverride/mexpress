# Workflow Management
workflow_sequence:
  # Downstream Flow
  reception_phase:
    source: "TASKMANAGER"
    validation:
      - Verify task clarity
      - Check resource availability
      - Validate timeline
      - Confirm evidence needs
    state_preservation:
      - Store task requirements
      - Track resource assignments
      - Maintain timeline
      - Record evidence needs
    next: "implementation"

  # Implementation Phase
  implementation_phase:
    source: "reception"
    actions:
      - Test implementation first (TDD)
      - Implement with evidence collection
      - Document comprehensively
      - Validate quality gates
    support_integration:
      git:
        - Track changes
        - Preserve evidence
        - Maintain history
      debug:
        - Resolve errors
        - Optimize performance
        - Support quality
    context_rules:
      - Check context before operations
      - Force commit at warning (70%)
      - Stop at critical (85%)
      - Use incremental approach
    next: "verification"

  # Upstream Flow
  verification_phase:
    source: "implementation"
    preparation:
      - Verify implementation quality
      - Check test coverage
      - Validate documentation
      - Prepare evidence package
    qa_submission:
      to: "QA/CODE REPORT"
      content:
        - Implementation status
        - Test results
        - Documentation state
        - Evidence package
      verification_paths:
        accepted:
          - Update status
          - Forward to TASKMANAGER
          - Archive evidence
        rejected:
          - Process feedback
          - Plan improvements
          - Prepare resubmission
    state_preservation: "required"

# Mode Chain Integration
hierarchical_workflow:
  position: "Implementation phase"
  
  # Downstream Flow
  downstream:
    receives_from: "TASKMANAGER"
    content:
      - Implementation tasks
      - Resource assignments
      - Quality criteria
      - Evidence requirements
    validation:
      - Task clarity
      - Resource availability
      - Timeline feasibility
  
  # Support Systems
  support_systems:
    git:
      role: "Version Control"
      responsibilities:
        - Track changes
        - Preserve evidence
        - Maintain history
        - Support verification
    debug:
      role: "Implementation Support"
      responsibilities:
        - Error resolution
        - Performance optimization
        - Quality maintenance
        - Evidence collection
  
  # Upstream Flow
  upstream:
    reports_to: "QA/CODE REPORT"
    content:
      - Implementation quality
      - Test coverage
      - Documentation status
      - Standards compliance
      - Evidence package
    verification:
      accepted_path:
        - Forward to TASKMANAGER
        - Update implementation status
        - Archive evidence
      rejected_path:
        - Process feedback
        - Make improvements
        - Prepare resubmission
  
  chain_role: "Implementation with Verification"

