# General Cline Rules v2.0

# Core Configuration
mode: "roo_core"
description: "Core workflow and validation framework"
version: "2.0.0"

# Workflow Structure
workflow:
  # Bidirectional Flow
  downstream_flow:
    requirements:
      - Complete input validation
      - Chain initialization
      - Quality context documentation
      - State preservation
    validation:
      - Input completeness
      - Chain integrity
      - Quality preservation
      - State consistency

  upstream_flow:
    requirements:
      - Evidence collection
      - Quality verification
      - Chain maintenance
      - State updates
    validation:
      - Evidence completeness
      - Quality standards
      - Chain integrity
      - State consistency

# Chain Management
validation_chain:
  requirements:
    - Chain initialization
    - Evidence collection
    - Quality preservation
    - State management
    - Documentation maintenance

  verification_points:
    input:
      - Requirements completeness
      - Research validation
      - Success criteria verification
      - Value alignment

    quality:
      - Framework compliance
      - Standards adherence
      - Documentation completeness
      - Evidence preservation

    state:
      - Context preservation
      - Chain integrity
      - History maintenance
      - Metrics tracking

# Quality Framework
quality_framework:
  standards:
    - Quality context documentation
    - Evidence collection
    - Chain preservation
    - State management
    - Documentation maintenance

  validation:
    requirements:
      - Complete validation chain
      - Evidence preservation
      - Quality metrics
      - State consistency

    evidence:
      - Collection points defined
      - Evidence types documented
      - Chain preservation
      - Context maintenance

# State Management
state_management:
  requirements:
    - State initialization
    - Context preservation
    - Chain maintenance
    - History tracking
    - Metrics collection

  validation:
    - State consistency
    - Context integrity
    - Chain preservation
    - History maintenance
    - Metrics accuracy

# Mode Transitions
mode_transitions:
  requirements:
    - Complete validation chain
    - Quality context preserved
    - State properly managed
    - Documentation complete
    - Evidence collected

  validation:
    - Chain integrity
    - Context preservation
    - State consistency
    - Documentation completeness
    - Evidence verification

# Documentation Standards
documentation:
  requirements:
    - Complete coverage
    - Chain documentation
    - Evidence preservation
    - State tracking
    - Quality context

  validation:
    - Documentation completeness
    - Chain integrity
    - Evidence preservation
    - State consistency
    - Context maintenance

# Evidence Management
evidence:
  collection_points:
    - During validation
    - After transitions
    - During operations
    - After updates

  requirements:
    - Complete collection
    - Chain preservation
    - Context maintenance
    - State tracking

  validation:
    - Evidence completeness
    - Chain integrity
    - Context preservation
    - State consistency

# Quality Gates
quality_gates:
  input_validation:
    - Requirements completeness
    - Research validation
    - Success criteria verification
    - Value alignment

  quality_verification:
    - Framework compliance
    - Standards adherence
    - Documentation completeness
    - Evidence preservation

  state_validation:
    - Context preservation
    - Chain integrity
    - History maintenance
    - Metrics tracking

# Success Criteria
success_metrics:
  validation:
    - Chain completeness
    - Evidence preservation
    - Quality maintenance
    - State consistency
    - Documentation coverage

  requirements:
    - Complete validation chain
    - Preserved evidence
    - Maintained quality
    - Consistent state
    - Complete documentation

# Error Handling
error_handling:
  requirements:
    - Error documentation
    - Chain preservation
    - State recovery
    - Evidence collection
    - Context maintenance

  validation:
    - Error resolution
    - Chain integrity
    - State consistency
    - Evidence completeness
    - Context preservation

# File Permissions
edit_permissions:
  allowed_extensions:
    - .md
    - .json
    - .yaml
    - .yml
  restricted_paths:
    - /opt/mExpress/docs/