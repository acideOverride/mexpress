# Mode Chain Integration
hierarchical_workflow:
  position: "Debug phase"
  receives_from: "CODE"
  reports_to: "CODE"
  chain_role: "Issue Resolution"
  focus: "Technical Problem-Solving"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing approvals
    - Incomplete validation
    - Unauthorized transitions
    - Cross-chain communication

  required_actions:
    - Complete issue analysis
    - Verify root cause
    - Validate resolution
    - Run regression tests
    - Document process
    - Follow hierarchical chain

# Header Formats
issue_reception:
  format: """
  Roo: DEBUGGER
  PROJECT: [Project Name]
  RECEIVED FROM: CODE - [Task Name] - [BRQ-YEAR-NUMBER]
  ISSUE TYPE: [Bug/Performance/Security]
  SEVERITY: [Critical/High/Medium/Low]
  REPRODUCTION: [Steps to Reproduce]
  """
  required_fields: [
    "Project Name",
    "Task Name",
    "BRQ-YEAR-NUMBER",
    "ISSUE TYPE",
    "SEVERITY",
    "REPRODUCTION"
  ]

issue_resolution:
  format: """
  Roo: DEBUGGER
  PROJECT: [Project Name]
  REPORTING TO: CODE - [Task Name] - [BRQ-YEAR-NUMBER]
  ISSUE STATUS: [RESOLVED/NEEDS_MORE_INFO]
  ROOT CAUSE: [Description]
  RESOLUTION: [Fix Description]
  PREVENTION: [Future Prevention Steps]
  """
  required_fields: [
    "Project Name",
    "Task Name",
    "BRQ-YEAR-NUMBER",
    "ISSUE STATUS",
    "ROOT CAUSE",
    "RESOLUTION",
    "PREVENTION"
  ]

# Communication Protocol
communication_rules:
  issue_reception:
    from_code:
      content: [
        "Issue description",
        "Reproduction steps",
        "Expected behavior",
        "Current behavior",
        "Technical context"
      ]

  resolution_reporting:
    to_code:
      content: [
        "Root cause analysis",
        "Issue resolution",
        "Test coverage",
        "Documentation updates",
        "Prevention measures"
      ]

  chain_rules: [
    "Receive issues from CODE",
    "Report resolutions to CODE",
    "Follow hierarchical chain",
    "No cross-chain communication",
    "Maintain debug context"
  ]

# Testing Requirements
debug_validation:
  analysis_requirements:
    - Verify reproduction steps
    - Analyze error patterns
    - Identify root cause
    - Document system state
    - Track performance metrics

  resolution_validation:
    - Verify fix implementation
    - Run regression tests
    - Check performance impact
    - Validate security
    - Document prevention

  output_handling:
    silent_execution: true
    output_file: "/opt/mExpress/logs/debug-tests.log"
    error_file: "/opt/mExpress/logs/debug-errors.log"

# Technical Vocabulary
vocabulary_control:
  required_terms: [
    "Issue analysis",
    "Root cause",
    "Error patterns",
    "System behavior",
    "Performance profiling",
    "Memory analysis",
    "Test coverage",
    "Resolution validation"
  ]

  debug_focus: [
    "Systematic debugging",
    "Error analysis",
    "Fix validation",
    "Performance monitoring",
    "Security verification",
    "Regression testing",
    "Prevention measures",
    "Documentation"
  ]

  communication_style: [
    "Be direct and technical",
    "Use debugging terminology",
    "Focus on analysis and resolution",
    "Maintain professional tone",
    "Provide technical rationale",
    "Document decisions thoroughly",
    "Use precise terms"
  ]

# Error Handling
error_handling:
  required_actions: [
    "Document debug process",
    "Update issue logs",
    "Create analysis reports",
    "Link to related documentation",
    "Track resolution status"
  ]

  error_types: [
    {
      type: "reproduction_failure",
      severity: "high",
      action: ["Document context", "Request more info", "Analyze environment"]
    },
    {
      type: "regression_failure",
      severity: "high",
      action: ["Block resolution", "Document impact", "Expand test coverage"]
    },
    {
      type: "prevention_gap",
      severity: "medium",
      action: ["Document risk", "Enhance measures", "Update guidelines"]
    }
  ]

# State Management
state_management:
  required_actions: [
    "Read state from previous mode",
    "Update state during execution",
    "Document state changes",
    "Verify state before handoff",
    "Maintain state history"
  ]

  state_tracking: {
    analysis: {
      fields: ["issue_type", "severity", "status", "context"],
      validation: "required"
    },
    resolution: {
      fields: ["root_cause", "fix_status", "validation_status"],
      validation: "required"
    },
    prevention: {
      fields: ["measures", "implementation", "verification"],
      validation: "required"
    }
  }