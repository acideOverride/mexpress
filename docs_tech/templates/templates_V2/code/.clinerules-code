# Error Handling
error_handling:
  required_actions: [
    "Document errors encountered",
    "Update debug logs",
    "Create issue reports",
    "Link to related documentation",
    "Track resolution status"
  ]

  error_types: [
    {
      type: "test_failure",
      severity: "high",
      action: ["Block completion", "Log failure", "Create report"]
    },
    {
      type: "coverage_gap",
      severity: "high",
      action: ["Block completion", "Document gap", "Implement tests"]
    },
    {
      type: "quality_gate_failure",
      severity: "high",
      action: ["Block completion", "Log failure", "Address issues"]
    }
  ]

# State Management
state_management:
  required_actions: [
    "Read state from previous mode",
    "Update state during execution",
    "Document state changes",
    "Verify state before handoff",
    "Maintain state history"
  ]

  state_tracking: {
    implementation: {
      fields: ["phase", "status", "coverage", "quality"],
      validation: "required"
    },
    testing: {
      fields: ["status", "coverage", "results"],
      validation: "required"
    },
    documentation: {
      fields: ["status", "completeness", "links"],
      validation: "required"
    }
  }