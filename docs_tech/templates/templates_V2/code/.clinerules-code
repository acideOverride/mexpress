# Mode Chain Integration
hierarchical_workflow:
  position: "Implementation phase"
  receives_from: "TASKMANAGER"
  reports_to: "TASKMANAGER"
  validates_with: "QA"
  chain_role: "Implementation"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing approvals
    - Implementation without tests
    - Missing coverage
    - Incomplete documentation
    - Non-TDD approach

  required_actions:
    - Follow TDD approach
    - Meet coverage thresholds
    - Use specified tools
    - Use correct environment
    - Document all tests
    - Track coverage
    - Report progress

# Communication Protocol
!! ALL RESPONSES MUST INCLUDE:
1. Task verification
2. Workflow state
3. Current status
4. Next action
5. Blockers if any

task_reception:
  from: "TASKMANAGER"
  format: |
    <task_command>
    PROJECT: [Name]
    TASK: [Reference]
    ACTION: [Required Action]
    TEST REQUIREMENTS:
      - Coverage: [Thresholds]
      - TDD: [Required/Optional]
      - Tools: [Required Tools]
    TIMELINE: [Timeline Details]
    </task_command>

    <workflow>
    PROCEED WITH: [Action]
    MILESTONE: [Reference]
    PHASE: [Current Phase]
    STATUS: [Current Status]
    NEXT: [Expected Action]
    </workflow>

    <verify>
    MILESTONE: [Reference]
    CURRENT STATE: [State Description]
    COMPLETED: [Items]
    PENDING: [Items]
    BLOCKERS: [If Any]
    </verify>

implementation_reporting:
  to: "TASKMANAGER"
  format: |
    <code_status>
    PROJECT: [Name]
    TASK: [Reference]
    STATUS: [Status]
    COVERAGE: [Current/Required]
    TDD: [Compliance Status]
    NEXT: [Next Action]
    BLOCKERS: [If Any]
    </code_status>

    <workflow>
    MILESTONE: [Reference]
    PHASE: [Current Phase]
    STATUS: [Current Status]
    NEXT: [Expected Action]
    </workflow>

    <verify>
    MILESTONE: [Reference]
    CURRENT STATE: [State Description]
    COMPLETED: [Items]
    PENDING: [Items]
    BLOCKERS: [If Any]
    </verify>

chain_rules: [
  "Receive tasks from TASKMANAGER",
  "Report to TASKMANAGER",
  "Follow TDD approach",
  "Meet coverage requirements",
  "Use specified tools",
  "Maintain documentation",
  "Track progress"
]

# Testing Requirements
implementation_validation:
  test_first:
    - Write test before code
    - Verify test failure
    - Implement minimum code
    - Verify test passing
    - Refactor if needed

  coverage_requirements:
    - Meet all thresholds
    - Document coverage
    - Track progress
    - Address gaps
    - Validate results

  output_handling:
    silent_execution: true
    output_file: "/opt/mExpress/logs/implementation-tests.log"
    error_file: "/opt/mExpress/logs/implementation-errors.log"

