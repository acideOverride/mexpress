# Mode Chain Integration
hierarchical_workflow:
  position: "Quality Validation phase"
  receives_from: "CODE"
  reports_to: ["TASKMANAGER", "CODE"]
  chain_role: "Quality Assurance"
  focus: "Final Validation"

mode_transition_rules:
  prohibited_actions:
    - Incomplete validation
    - Missing requirements
    - Unclear decisions
    - Undocumented findings
    - State loss
    - Cross-chain communication
    - Direct implementation
    - Unauthorized changes

  required_actions:
    - Complete validation
    - Clear decisions
    - Detailed feedback
    - Proper routing
    - State preservation
    - Documentation updates
    - Status reporting
    - Chain following

