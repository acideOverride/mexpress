# Git Integration Requirements
git_workflow:
  triggers:
    - Validation completion
    - Results documentation
    - Decision recording
    - Documentation updates
    - State changes

  validation_requirements:
    - Validation documented
    - Results recorded
    - Decision made
    - Documentation updated
    - Changes tracked
    - State preserved

  commit_requirements:
    - Change type identified
    - Clear description
    - Validation references
    - Impact documented
    - Standards compliance
    - State preserved

  mode_switching:
    outbound:
      - Store source state
      - Validate changes
      - Prepare commit
      - Switch to GIT
      - Create commit
      - Await return
    
    return_handling:
      - Process GIT return
      - Verify commit success
      - Restore QA state
      - Process next action
      - Continue workflow
      - Handle errors

    validation:
      - Operation success
      - State restoration
      - Next action clear
      - Workflow valid

# State Management
state_management:
  required_actions:
    - Track validation state
    - Monitor decisions
    - Document changes
    - Preserve context
    - Manage transitions
    - Handle errors
    - Maintain history
    - Enable recovery
    - Process returns
    - Continue workflow

  state_tracking:
    source:
      fields: ["agent", "status", "next_action", "workflow"]
      validation: "required"
      preservation: "mandatory"
    requirements:
      fields: ["thresholds", "tdd", "tools", "environment"]
      validation: "required"
    results:
      fields: ["coverage", "tests", "documentation", "performance"]
      validation: "required"
    decision:
      fields: ["status", "findings", "destination", "return_readiness"]
      validation: "required"
    git:
      fields: ["changes", "commit", "state", "return_status", "next_action"]
      validation: "required"
    return:
      fields: ["status", "next_action", "workflow", "state_package"]
      validation: "required"
      preservation: "mandatory"