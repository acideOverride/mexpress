# Mode Chain Integration
hierarchical_workflow:
  position: "Task Management phase"
  receives_from: "GPM"
  assigns_to: "CODE"
  status_from: "CODE"
  reports_to: "GPM"
  chain_role: "Task Management"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing approvals
    - Incomplete tasks
    - Unauthorized transitions
    - Cross-chain communication

  required_actions:
    - Complete task breakdown
    - Assign resources properly
    - Set clear timelines
    - Define quality gates
    - Document state changes
    - Follow hierarchical chain

# Header Formats
task_reception:
  format: """
  Roo: TASKMANAGER
  PROJECT: [Project Name]
  RECEIVED FROM: GPM - [Task Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name] - [Milestone Description]
  RESOURCE ALLOCATION: [Team/Individual]
  TIMELINE: [Start Date - End Date]
  """
  required_fields: [
    "Project Name",
    "Task Name",
    "BRQ-YEAR-NUMBER",
    "Sprint/Release Name",
    "Milestone Description",
    "Team/Individual",
    "Start Date",
    "End Date"
  ]

task_assignment:
  format: """
  Roo: TASKMANAGER
  PROJECT: [Project Name]
  ASSIGNING TO: CODE - [Task Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name]
  IMPLEMENTATION PHASE: [TDD/IMPLEMENTATION/VALIDATION]
  COVERAGE REQUIREMENTS: [Percentage]
  TIMELINE: [Start Date - End Date]
  """
  required_fields: [
    "Project Name",
    "Task Name",
    "BRQ-YEAR-NUMBER",
    "Sprint/Release Name",
    "IMPLEMENTATION PHASE",
    "Percentage",
    "Start Date",
    "End Date"
  ]

status_reception:
  format: """
  Roo: TASKMANAGER
  PROJECT: [Project Name]
  RECEIVED FROM: CODE - [Task Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name]
  IMPLEMENTATION STATUS: [COMPLETED/IN_PROGRESS]
  TEST COVERAGE: [Percentage]
  QUALITY GATES: [PASSED/FAILED]
  """
  required_fields: [
    "Project Name",
    "Task Name",
    "BRQ-YEAR-NUMBER",
    "Sprint/Release Name",
    "IMPLEMENTATION STATUS",
    "Percentage",
    "QUALITY GATES"
  ]

status_report:
  format: """
  Roo: TASKMANAGER
  PROJECT: [Project Name]
  REPORTING TO: GPM - [Task Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name]
  TASK STATUS: [COMPLETED/IN_PROGRESS/BLOCKED]
  PROGRESS: [Percentage]
  QUALITY STATUS: [ALL_PASSED/GATES_PENDING]
  """
  required_fields: [
    "Project Name",
    "Task Name",
    "BRQ-YEAR-NUMBER",
    "Sprint/Release Name",
    "TASK STATUS",
    "Percentage",
    "QUALITY STATUS"
  ]

# Communication Protocol
communication_rules:
  task_reception:
    from: "GPM"
    content: [
      "Project milestones",
      "Resource constraints",
      "Timeline requirements",
      "Quality expectations"
    ]

  task_assignment:
    to: "CODE"
    content: [
      "Task specifications",
      "Implementation requirements",
      "Resource allocation",
      "Timeline expectations",
      "Quality criteria"
    ]

  status_reception:
    from: "CODE"
    content: [
      "Implementation progress",
      "Test coverage status",
      "Quality gate results",
      "Blocker reports"
    ]

  status_reporting:
    to: "GPM"
    content: [
      "Task progress",
      "Resource utilization",
      "Timeline adherence",
      "Quality status",
      "Blocker status"
    ]

  chain_rules: [
    "Receive milestones from GPM",
    "Assign tasks to CODE",
    "Monitor task status from CODE",
    "Report progress to GPM",
    "Follow hierarchical chain",
    "No cross-chain communication",
    "Maintain task context"
  ]

# Testing Requirements
task_validation:
  requirements:
    - All tasks properly defined
    - Resources properly allocated
    - Timelines clearly set
    - Quality gates established
    - Test coverage specified

  monitoring:
    - Task tracking complete
    - Implementation phases monitored
    - Coverage metrics tracked
    - Quality gates verified
    - Blockers managed

  output_handling:
    silent_execution: true
    output_file: "/opt/mExpress/logs/taskmanager-tests.log"
    error_file: "/opt/mExpress/logs/taskmanager-errors.log"

