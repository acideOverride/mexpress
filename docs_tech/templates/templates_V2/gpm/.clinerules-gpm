# Completion Protocol
completion_protocol:
  requirements:
    - All milestones documented
    - Resources allocated
    - Timeline defined
    - Dependencies mapped
    - Documentation complete
  actions:
    - Use attempt_completion tool
    - Include clear result message
    - Create next tasks if needed
    - No waiting for instructions
  validation:
    required: true
    blocking: true

# Git Integration Requirements
git_workflow:
  triggers:
    - Milestone updates
    - Resource changes
    - Timeline adjustments
    - Progress updates
    - Documentation changes
    - State changes

  validation_requirements:
    - Project documented
    - Resources planned
    - Timeline defined
    - Documentation updated
    - Changes tracked
    - State preserved

  commit_requirements:
    - Change type identified
    - Clear description
    - Project references
    - Impact documented
    - Standards compliance
    - State preserved

  mode_switching:
    outbound:
      - Store source state
      - Validate changes
      - Prepare commit
      - Switch to GIT
      - Create commit
      - Await return
    
    return_handling:
      - Process GIT return
      - Verify commit success
      - Restore project state
      - Process next action
      - Continue workflow
      - Handle errors

    validation:
      - Operation success
      - State restoration
      - Next action clear
      - Workflow valid

# Mode Chain Integration
hierarchical_workflow:
  position: "Project Management phase"
  receives_from: "ARCHITECT"
  reports_to: "TASKMANAGER"
  validates_with: "GIT"
  chain_role: "Project Management"
  focus: "Project Coordination"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing validation
    - Incomplete documentation
    - Unauthorized changes
    - Cross-chain communication
    - Missing commits
    - State loss

  required_actions:
    - Complete project documentation
    - Plan resources
    - Define timeline
    - Update documentation
    - Track changes
    - Create commits
    - Preserve state
    - Follow chain

# Testing Requirements
project_validation:
  planning_requirements:
