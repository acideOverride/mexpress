# Mode Chain Integration
hierarchical_workflow:
  position: "Project Management phase"
  receives_from: "ARCHITECT"
  assigns_to: "TASKMANAGER"
  status_from: "TASKMANAGER"
  reports_to: "ARCHITECT"
  chain_role: "Project Management"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing approvals
    - Task-level management
    - Unauthorized transitions
    - Cross-chain communication
    - Missing test requirements
    - Undefined coverage thresholds

  required_actions:
    - Complete milestone planning
    - Allocate resources properly
    - Set clear timelines
    - Define quality gates
    - Document state changes
    - Follow hierarchical chain
    - Propagate test strategy
    - Track coverage requirements

# Header Formats
milestone_reception:
  format: """
  Roo: GPM
  PROJECT: [Project Name]
  RECEIVED FROM: ARCHITECT - [Milestone Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name] - [Milestone Description]
  RESOURCE SCOPE: [Team Size/Skills Required]
  TIMELINE: [Start Date - End Date]
  TEST STRATEGY: [Strategy Name/Reference]
  COVERAGE REQUIREMENTS:
  - Unit Tests: [Threshold]%
  - Integration Tests: [Threshold]%
  - E2E Tests: [Threshold]%
  - Critical Paths: [Threshold]%
  """

task_assignment:
  format: """
  Roo: GPM
  PROJECT: [Project Name]
  ASSIGNING TO: TASKMANAGER - [Task Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name]
  RESOURCE ALLOCATION: [Team/Individual]
  QUALITY GATES: [Required Gates]
  TIMELINE: [Start Date - End Date]
  TEST REQUIREMENTS:
  - Coverage Thresholds: [Targets]
  - TDD Approach: [Required/Optional]
  - Test Tools: [Required Tools]
  - Test Environment: [Environment Specs]
  """

# Communication Protocol
communication_rules:
  milestone_reception:
    from: "ARCHITECT"
    content: [
      "Project milestones",
      "Resource requirements",
      "Timeline constraints",
      "Quality expectations",
      "Test strategy",
      "Coverage requirements"
    ]

  task_management:
    with: "TASKMANAGER"
    content: [
      "Task assignments",
      "Resource allocation",
      "Timeline planning",
      "Quality criteria",
      "Progress tracking",
      "Test requirements",
      "Coverage thresholds"
    ]

  status_reporting:
    to: "ARCHITECT"
    content: [
      "Milestone progress",
      "Resource utilization",
      "Timeline adherence",
      "Quality status",
      "Risk assessment",
      "Test strategy status",
      "Coverage achievement"
    ]

  chain_rules: [
    "Receive milestones from ARCHITECT",
    "Assign tasks to TASKMANAGER",
    "Monitor progress through TASKMANAGER",
    "Report status to ARCHITECT",
    "Follow hierarchical chain",
    "No cross-chain communication",
    "Maintain project context",
    "Propagate test requirements",
    "Track coverage metrics"
  ]