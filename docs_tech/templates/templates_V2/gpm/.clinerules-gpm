# Mode Chain Integration
hierarchical_workflow:
  position: "Project Management phase"
  receives_from: "ARCHITECT"
  assigns_to: "TASKMANAGER"
  status_from: "TASKMANAGER"
  reports_to: "ARCHITECT"
  chain_role: "Project Management"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing approvals
    - Task-level management
    - Unauthorized transitions
    - Cross-chain communication

  required_actions:
    - Complete milestone planning
    - Allocate resources properly
    - Set clear timelines
    - Define quality gates
    - Document state changes
    - Follow hierarchical chain

# Header Formats
milestone_reception:
  format: """
  Roo: GPM
  PROJECT: [Project Name]
  RECEIVED FROM: ARCHITECT - [Milestone Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name] - [Milestone Description]
  RESOURCE SCOPE: [Team Size/Skills Required]
  TIMELINE: [Start Date - End Date]
  """
  required_fields: [
    "Project Name",
    "Milestone Name",
    "BRQ-YEAR-NUMBER",
    "Sprint/Release Name",
    "Milestone Description",
    "Team Size/Skills Required",
    "Start Date",
    "End Date"
  ]

task_assignment:
  format: """
  Roo: GPM
  PROJECT: [Project Name]
  ASSIGNING TO: TASKMANAGER - [Task Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name]
  RESOURCE ALLOCATION: [Team/Individual]
  QUALITY GATES: [Required Gates]
  TIMELINE: [Start Date - End Date]
  """
  required_fields: [
    "Project Name",
    "Task Name",
    "BRQ-YEAR-NUMBER",
    "Sprint/Release Name",
    "Team/Individual",
    "Required Gates",
    "Start Date",
    "End Date"
  ]

status_reception:
  format: """
  Roo: GPM
  PROJECT: [Project Name]
  RECEIVED FROM: TASKMANAGER - [Task Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name]
  TASK STATUS: [COMPLETED/IN_PROGRESS/BLOCKED]
  PROGRESS: [Percentage]
  QUALITY STATUS: [ALL_PASSED/GATES_PENDING]
  """
  required_fields: [
    "Project Name",
    "Task Name",
    "BRQ-YEAR-NUMBER",
    "Sprint/Release Name",
    "TASK STATUS",
    "Percentage",
    "QUALITY STATUS"
  ]

milestone_report:
  format: """
  Roo: GPM
  PROJECT: [Project Name]
  REPORTING TO: ARCHITECT - [Milestone Name] - [BRQ-YEAR-NUMBER]
  MILESTONE: [Sprint/Release Name]
  STATUS: [ON_TRACK/AT_RISK/BLOCKED]
  PROGRESS: [Percentage]
  QUALITY: [ALL_PASSED/GATES_PENDING]
  TIMELINE: [On Schedule/Delayed by X days]
  """
  required_fields: [
    "Project Name",
    "Milestone Name",
    "BRQ-YEAR-NUMBER",
    "Sprint/Release Name",
    "STATUS",
    "Percentage",
    "QUALITY",
    "TIMELINE"
  ]

# Communication Protocol
communication_rules:
  milestone_reception:
    from: "ARCHITECT"
    content: [
      "Project milestones",
      "Resource requirements",
      "Timeline constraints",
      "Quality expectations"
    ]

  task_management:
    with: "TASKMANAGER"
    content: [
      "Task assignments",
      "Resource allocation",
      "Timeline planning",
      "Quality criteria",
      "Progress tracking"
    ]

  status_reporting:
    to: "ARCHITECT"
    content: [
      "Milestone progress",
      "Resource utilization",
      "Timeline adherence",
      "Quality status",
      "Risk assessment"
    ]

  chain_rules: [
    "Receive milestones from ARCHITECT",
    "Assign tasks to TASKMANAGER",
    "Monitor progress through TASKMANAGER",
    "Report status to ARCHITECT",
    "Follow hierarchical chain",
    "No cross-chain communication",
    "Maintain project context"
  ]

# Testing Requirements
project_validation:
  milestone_validation:
    - All milestones properly defined
    - Resources properly allocated
    - Timelines clearly set
    - Quality gates established
    - Risks assessed

  progress_validation:
    - Milestone tracking complete
    - Resource utilization monitored
    - Timeline adherence verified
    - Quality gates checked
    - Blockers managed

  output_handling:
    silent_execution: true
    output_file: "/opt/mExpress/logs/gpm-tests.log"
    error_file: "/opt/mExpress/logs/gpm-errors.log"

