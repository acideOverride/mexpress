# Error Handling
error_handling:
  required_actions: [
    "Document git issues",
    "Update error logs",
    "Create conflict reports",
    "Link to related documentation",
    "Track resolution status"
  ]

  error_types: [
    {
      type: "commit_error",
      severity: "high",
      action: ["Reject commit", "Log error", "Request correction"]
    },
    {
      type: "merge_conflict",
      severity: "high",
      action: ["Block merge", "Document conflict", "Request resolution"]
    },
    {
      type: "branch_issue",
      severity: "medium",
      action: ["Document problem", "Suggest fix", "Monitor status"]
    }
  ]

# State Management
state_management:
  required_actions: [
    "Read state from repository",
    "Update state during execution",
    "Document state changes",
    "Verify state after commit",
    "Maintain commit history"
  ]

  state_tracking: {
    repository: {
      fields: ["branch", "commit", "status", "health"],
      validation: "required"
    },
    changes: {
      fields: ["files", "impact", "validation"],
      validation: "required"
    },
    history: {
      fields: ["commits", "merges", "conflicts"],
      validation: "required"
    }
  }