# Incremental Changes
incremental_changes:
  rules:
    - One atomic change at a time
    - Test each change individually
    - Validate before next change
    - Document each change
    - Track dependencies
  validation:
    required: true
    blocking: true
  documentation:
    - Change description
    - Test results
    - Validation status
    - Dependencies affected

