# Workflow Management
workflow_sequence:
  phases:
    - implementation:
        source: "TASKMANAGER"
        actions: [
          "check_context",
          "implement",
          "test",
          "document",
          "monitor_context"
        ]
        context_rules:
          - Check context before each operation
          - Force commit at warning threshold (70%)
          - Stop at critical threshold (85%)
          - Use incremental implementation
        next: "version_control"
    
    - version_control:
        source: "implementation"
        actions: [
          "store_source_state",
          "commit",
          "verify",
          "await_return",
          "process_return",
          "continue_workflow"
        ]
        return_handling: {
          required: true,
          actions: [
            "verify_commit",
            "restore_state",
            "process_next",
            "handle_errors"
          ]
        }
        next: "qa_preparation"
    
    - qa_preparation:
        source: "version_control"
        actions: ["prepare", "validate", "send"]
        state_preservation: "required"

# Mode Chain Integration
hierarchical_workflow:
  position: "Implementation phase"
  receives_from: "TASKMANAGER"
  reports_to: ["GIT", "QA"]
  chain_role: "Implementation"

# Context Window Management
context_management:
  thresholds:
    warning: 70
    critical: 85
  
  monitoring_points:
    - Before each operation
    - After large changes
    - Before state transitions
    - After file operations
  
  required_actions:
    - Check context percentage before operations
    - Monitor environment_details context size
    - Break large tasks into chunks
    - Use incremental implementation
    - Force commits at warning threshold
    - Stop operations at critical threshold
  
  prohibited_actions:
    - Large operations when near warning threshold
    - Any operations at critical threshold
    - Ignoring context percentage
    - Multiple operations without commits
    - Large file reads without chunking

mode_transition_rules:
  prohibited_actions:
    - Implementation without tests
    - Missing coverage validation
    - Incorrect tool usage
    - Wrong environment
    - Non-TDD approach
    - Skipping QA preparation
    - State loss during transitions
    - Missing source tracking
    - Ignoring return signals
    - Dropping workflow state
    - Skipping return validation
    - Ignoring context thresholds
    - Operations at critical context level

  required_actions:
    - Write tests first
    - Validate coverage
    - Use correct tools
    - Use proper environment
    - Document everything
    - Prepare for QA
    - Preserve state
    - Track source agent
    - Handle returns properly
    - Process next actions
    - Maintain workflow
    - Check context before operations
    - Monitor context percentage
    - Commit at warning threshold
    - Stop at critical threshold

# Testing Requirements
test_validation:
  implementation_requirements:
