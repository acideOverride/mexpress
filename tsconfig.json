{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@mexpress/core": ["packages/core/src"],
      "@mexpress/ui": ["packages/ui-components/src"],
      "@mexpress/utils": ["packages/utils/src"]
    },
    "target": "es2020",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": ["node_modules", "dist"]
}
