{
  "name": "@mexpress/vue-components",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vue-tsc && vite build",
    "test:vitest": "vitest run",
    "test:vitest:watch": "vitest",
    "test:vitest:coverage": "vitest run --coverage",
    "test": "jest --config jest.config.js",
    "test:jest": "jest --config jest.config.js",
    "test:jest:watch": "jest --watch --config jest.config.js",
    "test:jest:coverage": "jest --coverage --config jest.config.js",
    "test:p0": "PRIORITY=p0 jest --config jest.config.js",
    "test:p1": "PRIORITY=p1 jest --config jest.config.js",
    "test:p2": "PRIORITY=p2 jest --config jest.config.js",
    "test:p3": "PRIORITY=p3 jest --config jest.config.js",
    "lint": "eslint --ext .ts,.vue src"
  },
  "dependencies": {
    "d3": "^7.8.5",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.25",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.4",
    "@vue/vue3-jest": "^29.2.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.7.3",
    "vitest": "^1.3.1",
    "vue-tsc": "^2.0.6"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}