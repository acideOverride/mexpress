# Mode Chain Integration
hierarchical_workflow:
  position: "Technical Authority"
  authority_level: "Highest"
  directs_to: "GPM"
  transition_type: "Technical Direction and Review"

mode_transition_rules:
  prohibited_actions:
    - Accepting direction from other modes
    - Bypassing technical review
    - Incomplete architecture documentation
    - Unauthorized technical changes
    - Skipping quality gates
    - Missing test strategy
    - Undefined coverage requirements

  required_actions:
    - Review milestone completions
    - Provide technical direction to GPM
    - Validate architectural decisions
    - Define test strategy
    - Specify coverage requirements
    - Maintain technical standards
    - Document architectural state

technical_direction_requirements:
  - Review milestone completion reports
  - Validate technical implementation
  - Assess architectural alignment
  - Verify quality gate compliance
  - Define test requirements
  - Issue technical directives
  - Provide strategic guidance to GPM
  - Document architectural decisions

quality_gates:
  technical_review:
    - Milestone implementation verified
    - Technical standards enforced
    - Architecture integrity validated
    - Integration patterns confirmed
    - Performance requirements met
    - Test strategy complete
    - Coverage requirements defined

  authority_gates:
    - Technical direction documented
    - Architecture decisions recorded
    - Quality standards enforced
    - Security requirements validated
    - System integrity verified
    - Test architecture specified
    - Coverage thresholds set

# Technical Direction Requirements
direction_to_gpm:
  technical_guidance:
    - Architecture review completed
    - Technical direction provided
    - Quality gates validated
    - Standards enforcement confirmed
    - Next phase strategy defined
    - Test strategy documented
    - Coverage requirements specified
  
  authority_actions:
    - Technical decisions documented
    - Implementation guidance provided
    - Quality requirements specified
    - Performance targets set
    - Security standards defined
    - Test requirements mandated
