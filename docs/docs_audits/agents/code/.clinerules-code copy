# Workflow Management
workflow_sequence:
  phases:
    - implementation:
        source: "TASKMANAGER"
        actions: [
          "check_context",
          "implement",
          "test",
          "document",
          "monitor_context"
        ]
        context_rules:
          - Check context before each operation
          - Force commit at warning threshold (70%)
          - Stop at critical threshold (85%)
          - Use incremental implementation
        next: "version_control"
    
    - version_control:
        source: "implementation"
        actions: [
          "store_source_state",
          "commit",
          "verify",
          "await_return",
          "process_return",
          "continue_workflow"
        ]
        return_handling: {
          required: true,
          actions: [
            "verify_commit",
            "restore_state",
            "process_next",
            "handle_errors"
          ]
        }
        next: "qa_preparation"
    
    - qa_preparation:
        source: "version_control"
        actions: ["prepare", "validate", "send"]
        state_preservation: "required"

