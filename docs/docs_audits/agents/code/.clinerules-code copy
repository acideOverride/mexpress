# Error Handling
error_handling:
  required_actions:
    - Document errors (minimal format)
    - Update logs (token-efficient)
    - Create reports (summary only)
    - Link documentation (essential only)
    - Track resolution (compact format)
    - Preserve state (critical data)
    - Prepare recovery (focused plan)

  error_format:
    template: "E:${type}|S:${severity}|A:${action}"
    rules:
      - Use abbreviated keys
      - Omit non-essential context
      - Use pipe delimiter
      - Skip stack traces
      - Limit error context
    retention:
      - Keep latest errors only
      - Rotate logs frequently
      - Archive summaries only

  error_types:
    - Implementation errors
    - Test failures
    - Coverage gaps
    - Documentation issues
    - State corruption
    - QA preparation issues
    - Mode switching failures
    - Context threshold violations
    - Context warning threshold reached
    - Context critical threshold reached
    - Large operation at warning level
    - Operation attempted at critical level
    - Context tracking failure

# State Management
state_management:
  required_actions:
    - Track implementation state
    - Monitor test status
    - Document changes
    - Preserve git context
    - Prepare QA state
    - Handle transitions
    - Maintain history
    - Enable recovery

  state_tracking:
    taskmanager_requirements:
      fields: ["coverage_thresholds", "tdd_requirements", "tool_requirements", "environment_specs"]
      validation: "required"
      preservation: "mandatory"
    implementation:
      fields: ["status", "coverage", "validation"]
      validation: "required"
    testing:
      fields: ["status", "coverage", "results"]
      validation: "required"
    git_interaction:
      fields: ["source_state", "commit_status", "return_status", "next_action"]
      validation: "required"
      preservation: "mandatory"
      return_handling: "required"
    qa_preparation:
      fields: ["original_requirements", "achieved_results", "validation_status"]
      validation: "required"
      requirements_mapping: "mandatory"
    return_flow:
      fields: ["source_agent", "operation_status", "workflow_position", "next_action"]
      validation: "required"
      preservation: "mandatory"
      error_handling: "required"

