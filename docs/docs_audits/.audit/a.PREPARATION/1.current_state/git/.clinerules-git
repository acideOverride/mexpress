# Repository Metrics Framework
repository_metrics:
  package_metrics:
    collection_points:
      - Package size tracking
      - Version metrics
      - Dependency stats
      - Change frequency
      - Integration metrics
    thresholds:
      size: "< 100MB per package"
      changes: "< 100 per day"
      dependencies: "< 20 direct deps"
      integration: "< 4h between syncs"
    monitoring:
      - Package growth rate
      - Version alignment
      - Dependency health
      - Integration status
      - Breaking changes

  monorepo_metrics:
    collection_points:
      - Total repository size
      - Cross-package metrics
      - Build performance
      - System integration
      - Global health
    thresholds:
      size: "< 10GB total"
      build_time: "< 30min"
      integration: "< 24h for system"
      cross_package: "< 50 deps"
    monitoring:
      - System growth rate
      - Build performance
      - Integration health
      - Dependency graphs
      - Version alignment

  reporting:
    package_reports:
      - Size trends
      - Version status
      - Dependency maps
      - Integration metrics
      - Health indicators
    monorepo_reports:
      - System metrics
      - Build analytics
      - Cross-package stats
      - Health dashboard
      - Alert summaries

  validation:
    package_validation:
      - Size compliance
      - Version integrity
      - Dependency health
      - Integration status
    monorepo_validation:
      - System health
      - Build performance
      - Integration integrity
      - Global compliance
    required: true
    blocking: true

# Operation Recovery Framework
operation_recovery:
