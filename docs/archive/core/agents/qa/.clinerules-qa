# Quality Standards
quality_standards:
 package_requirements:
   validation:
     - Package boundary integrity
     - API compatibility
     - Dependency health
     - Version alignment
     - Cross-package communication
     - Integration patterns
     - Shared code usage
   metrics:
     api_stability: 95%
     dependency_health: 90%
     version_match: 100%
     integration_coverage: 85%
     communication_efficiency: 90%
   validation_rules:
     - No breaking API changes
     - All dependencies up to date
     - Version numbers synchronized
     - Integration tests passing
     - Communication paths verified
   blocking: true
   skip_allowed: false

 monorepo_requirements:
   validation:
     - Repository structure
     - Build configuration
     - Package organization
     - Integration patterns
     - Shared code management
     - Version control
     - Cross-package dependencies
   metrics:
     build_success: 100%
     integration_stability: 95%
     package_isolation: 90%
     shared_coverage: 85%
     dependency_health: 95%
   validation_rules:
     - Build pipeline passing
     - All packages integrated
     - No circular dependencies
     - Shared code properly managed
     - Version control synchronized
   blocking: true
   skip_allowed: false

 implementation_requirements:
   validation:
     - Code quality standards
     - Test coverage thresholds
     - Performance benchmarks
     - Security requirements
     - Documentation completeness
     - Cross-package integration
     - Monorepo compliance
   metrics:
     code_quality: 90%
     test_coverage:
       unit: 85%
       integration: 80%
       e2e: 75%
     performance:
       response_time: "< 100ms"
       memory_usage: "< 256MB"
       cpu_usage: "< 70%"
     security:
       vulnerability_scan: "pass"
       dependency_check: "pass"
       code_signing: "verified"
   validation_rules:
     - All quality gates passed
     - Coverage thresholds met
     - Performance targets achieved
     - Security scans passed
     - Documentation up to date
     - Package integration verified
     - Monorepo standards met
   blocking: true
   skip_allowed: false

# Test Execution Requirements
test_execution:
  validation_sequence:
    required: true
    blocking: true
    skip_allowed: false
    steps:
      1. Execute validation tests silently
      2. Output to validation logs
      3. Verify coverage metrics
      4. Check performance targets
      5. Validate security standards
      6. Document validation results
    validation:
      - No validation without coverage
      - No acceptance with failures
      - Performance targets met
      - Security standards met
      - Documentation complete

  evidence_requirements:
    required: true
    blocking: true
    skip_allowed: false
    validation:
      - Evidence collection complete
      - Documentation requirements met
      - Chain preservation verified
      - Standards compliance confirmed

  output_handling:
    silent_execution: true
    output_file: "/opt/mExpress/logs/validation.log"
    error_file: "/opt/mExpress/logs/validation-errors.log"
    required: true
    blocking: true

