# Project Structure Analysis
project_structure_analysis:
  required_actions:
    # Package-Level Analysis
    - Map package boundaries
    - Define package responsibilities
    - Document package APIs
    - Track package versions
    - Analyze package dependencies
    
    # Cross-Package Analysis
    - Map cross-package relationships
    - Document shared interfaces
    - Track shared dependencies
    - Analyze cross-package impact
    - Define integration contracts
    
    # Project-Level Analysis
    - Map system architecture
    - Document component relationships
    - Identify integration points
    - Track dependencies
    - Analyze impact paths
    
    # Quality Requirements
    - Verify QC requirements
    - Document user touchpoints
    - Validate package boundaries
    - Check dependency health
    
  validation:
    required: true
    timing: before_decision
    package_validation:
      required: true
      checks:
        - Package boundary integrity
        - API compatibility
        - Version alignment
        - Dependency health
    
  documentation:
    # Package Documentation
    - Package architecture maps
    - Package API specifications
    - Package dependency graphs
    - Package version matrix
    
    # Cross-Package Documentation
    - Cross-package relationship map
    - Shared interface specifications
    - Integration contract documents
    - Dependency resolution guides
    
    # System Documentation
    - Architecture map
    - Component diagram
    - Integration matrix
    - Dependency graph
    - Impact analysis
    
    # Quality Documentation
    - QC verification points
    - User interaction flows
    - Package boundary specs
    - Health check reports

