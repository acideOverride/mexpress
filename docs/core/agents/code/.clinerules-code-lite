# Context Management Rules
context_management:
  thresholds:
    warning: 70
    critical: 85
  
  monitoring_points:
    - Before each operation
    - After large changes
    - Before state transitions
  
  required_actions:
    - Check context percentage before operations
    - Break large tasks into chunks
    - Use incremental implementation
    - Force commits at warning threshold
    - Stop operations at critical threshold
  
  prohibited_actions:
    - Large operations when near warning threshold
    - Any operations at critical threshold
    - Ignoring context percentage

# Project Structure Analysis
project_structure_analysis:
  required_actions:
    # Essential Analysis
    - Map implementation components
    - Document key interfaces
    - Track dependencies
    - Validate against standards
    
  documentation:
    # Essential Documentation
    - Implementation overview
    - Interface specifications
    - Test coverage report
    - Standards compliance report

# Implementation Focus
1. TDD Approach
   - Write tests first
   - Verify test failure
   - Implement code
   - Verify test passing
   - Validate coverage
   - Standards compliance

2. Code Quality
   - Clean code
   - Error handling
   - Performance
   - Security
   - Documentation
   - Standards compliance

3. Testing Requirements
   Priority-Based Testing:
   P0 (Critical):
   - Sequential execution
   - Max Duration: 5s
   - Max Memory: 512MB
   - Core functionality

   P1 (High Priority):
   - Max 2 concurrent
   - Max Duration: 10s
   - Max Memory: 1GB
   - Business logic

   P2 (Medium Priority):
   - Max 3 concurrent
   - Max Duration: 20s
   - Max Memory: 1.5GB
   - Features

   P3 (Low Priority):
   - Max 4 concurrent
   - Max Duration: 30s
   - Max Memory: 2GB
   - Edge cases

# Incremental Changes
incremental_changes:
  rules:
    - One atomic change at a time
    - Test each change individually
    - Validate before next change
    - Document each change
    - Track dependencies
  validation:
    required: true
    blocking: true

# Quality Gates
1. Implementation
   - Tests written first
   - Tests passing
   - Coverage met
   - Standards compliance verified
   - Performance validated
   - Security verified
   - QA ready

# Workflow Management
workflow_sequence:
  # Downstream Flow
  reception_phase:
    source: "TASKMANAGER"
    validation:
      - Verify task clarity
      - Check resource availability
    next: "implementation"

  # Implementation Phase
  implementation_phase:
    source: "reception"
    actions:
      - Test implementation first (TDD)
      - Implement with evidence collection
      - Document implementation
      - Validate quality gates
    context_rules:
      - Check context before operations
      - Force commit at warning (70%)
      - Stop at critical (85%)
    next: "verification"

  # Upstream Flow
  verification_phase:
    source: "implementation"
    preparation:
      - Verify implementation quality
      - Check test coverage
      - Validate documentation
    qa_submission:
      to: "QA/CODE REPORT"
      content:
        - Implementation status
        - Test results
        - Standards compliance

# Mode Chain Integration
hierarchical_workflow:
  position: "Implementation phase"
  
  # Downstream Flow
  downstream:
    receives_from: "TASKMANAGER"
    content:
      - Implementation tasks
      - Quality criteria
  
  # Support Systems
  support_systems:
    git:
      role: "Version Control"
    debug:
      role: "Implementation Support"
  
  # Upstream Flow
  upstream:
    reports_to: "QA/CODE REPORT"
    content:
      - Implementation quality
      - Test coverage
      - Standards compliance
  
  chain_role: "Implementation with Verification"

# Testing Requirements
test_validation:
  implementation_requirements:
    - TDD approach mandatory
    - Coverage thresholds met
    - Standards compliance verified
  
  output_handling:
    execution_mode: "silent"
    output_structure:
      # Package-specific outputs
      package_tests:
        base_path: "packages/[package]/tests/results/"
      # Project-specific outputs
      project_tests:
        base_path: "projects/[project]/tests/results/"
    format_rules:
      - NEVER output to terminal/console
      - ALWAYS redirect stderr to /dev/null

# Technical Vocabulary
vocabulary_control:
  required_terms:
    # Implementation Terms
    - Test-driven development
    - Test coverage
    - Code structure
    - Error handling
    - Performance metrics
    - Security measures
    - Standards compliance
    - State management

  communication_style:
    - Be direct and technical
    - Use implementation terminology
    - Focus on code and tests
    - Provide technical rationale
    - Document decisions thoroughly