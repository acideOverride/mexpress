# Error Handling
error_handling:
  required_actions:
    - Document errors (minimal format)
    - Update logs (token-efficient)
    - Create reports (summary only)
    - Link documentation (essential only)
    - Track resolution (compact format)
    - Preserve state (critical data)
    - Prepare recovery (focused plan)
    - Capture pre-error state
    - Validate state integrity
    - Execute rollback procedures
    - Verify state consistency
    - Monitor recovery status
    - Document state changes
    - Maintain recovery points
    - Test restored state

  error_format:
    template: "E:${type}|S:${severity}|A:${action}"
    rules:
      - Use abbreviated keys
      - Omit non-essential context
      - Use pipe delimiter
      - Skip stack traces
      - Limit error context
    retention:
      - Keep latest errors only
      - Rotate logs frequently
      - Archive summaries only

  error_types:
    # Package Errors
    - Package boundary violations
    - API incompatibilities
    - Dependency conflicts
    - Version mismatches
    - Cross-package issues
    - Package validation failures
    
    # Monorepo Errors
    - Build configuration issues
    - Package organization problems
    - Integration failures
    - Version alignment errors
    - Repository structure issues
    
    # Implementation Errors
    - Implementation errors
    - Test failures
    - Coverage gaps
    - Documentation issues
    - State corruption
    - QA preparation issues
    
    # Context Errors
    - Mode switching failures
    - Context threshold violations
    - Context warning threshold reached
    - Context critical threshold reached
    - Large operation at warning level
    - Operation attempted at critical level
    - Context tracking failure

