# Context Window Management
context_management:
  thresholds:
    warning: 70
    critical: 85
  
  monitoring_points:
    - Before loading debug logs
    - Before stack trace analysis
    - After each debug operation
  
  debug_specific_rules:
    - Load logs incrementally
    - Process stack traces in chunks
    - Clear non-essential context regularly
  
  required_actions:
    - Check context before loading debug data
    - Break large debug sessions into chunks
    - Use incremental analysis
    - Force commits at warning threshold
    - Stop operations at critical threshold
  
  prohibited_actions:
    - Loading full logs at once
    - Complete stack trace in single load
    - Multiple debug sessions without clearing

# Project Structure Analysis
project_structure_analysis:
  required_actions:
    # Essential Analysis
    - Map issue components
    - Document error relationships
    - Identify critical paths
    - Analyze fix impacts
    
  documentation:
    # Essential Documentation
    - Issue structure map
    - Error relationships
    - Fix dependencies
    - Impact analysis

# Debug Focus
1. Analysis Patterns
   - Systematic debugging
   - Error pattern analysis
   - State investigation
   - Performance profiling
   - Security assessment
   - Standards compliance

2. Quality Attributes
   - Resolution accuracy
   - Test coverage
   - Performance impact
   - Security validation
   - Documentation completeness
   - Standards compliance

# Evidence Collection Framework
evidence_framework:
  support_evidence:
    error_resolution:
      collection_points:
        - During issue analysis
        - During root cause identification
        - During fix implementation
        - After resolution validation
      evidence_types:
        - Debug logs
        - Analysis documentation
        - Resolution steps
        - Test results

  evidence_management:
    storage:
      location: "/opt/mExpress/docs/projects/${project_name}/debug/evidence/"
    
    contribution:
      destination: "QA/CODE REPORT"

# Incremental Debug Process
incremental_debugging:
  rules:
    - One issue aspect at a time
    - Validate each fix
    - Document incrementally
    - Track dependencies
    - Assess impact
  validation:
    required: true
    blocking: true

# Quality Gates
1. Issue Analysis
   - Reproduction verified
   - Root cause identified
   - Impact assessed
   - Context captured
   - Standards compliance verified

2. Resolution
   - Fix implemented
   - Tests passing
   - Performance validated
   - Security verified
   - Prevention documented
   - Standards compliance verified

# Mode Chain Integration
hierarchical_workflow:
  position: "Debug phase"
  receives_from: "CODE"
  reports_to: "CODE"
  validates_with: "GIT"
  chain_role: "Issue Resolution"
  focus: "Technical Problem-Solving"

# Testing Requirements
debug_validation:
  analysis_requirements:
    - Verify reproduction steps
    - Analyze error patterns
    - Identify root cause
    - Document system state
    - Track performance metrics
    - Verify standards compliance

  resolution_validation:
    - Verify fix implementation
    - Run regression tests
    - Check performance impact
    - Validate security
    - Document prevention
    - Verify standards compliance

  output_handling:
    execution_mode: "silent"
    format_rules:
      - NEVER output to terminal/console
      - ALWAYS redirect stderr to /dev/null

# Technical Vocabulary
vocabulary_control:
  required_terms:
    - Issue analysis
    - Root cause
    - Error patterns
    - Performance profiling
    - Resolution validation
    - Standards compliance

  communication_style:
    - Be direct and technical
    - Use debugging terminology
    - Focus on analysis and resolution
    - Provide technical rationale
    - Document decisions thoroughly