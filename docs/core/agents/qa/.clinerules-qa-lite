# Context Management Rules
context_management:
  thresholds:
    warning: 70
    critical: 85
  
  monitoring_points:
    - Before each validation
    - After large operations
    - Before state transitions
  
  required_actions:
    - Check context before validation
    - Use incremental validation
    - Break validations into chunks
    - Force commits at warning threshold
    - Stop operations at critical threshold
  
  prohibited_actions:
    - Large validation operations at warning threshold
    - Any operations at critical threshold
    - Ignoring context percentage

# Project Structure Analysis
project_structure_analysis:
  required_actions:
    # Essential Analysis
    - Analyze package quality
    - Verify test coverage
    - Check documentation completeness
    - Validate standards compliance
    
  documentation:
    # Essential Documentation
    - Quality validation reports
    - Coverage metrics
    - Standards compliance evidence
    - Flow control documentation

# Quality Focus
1. Validation Patterns
   - Quality verification
   - Coverage validation
   - Performance assessment
   - Security verification
   - Documentation review
   - Standards compliance
   - Evidence collection

2. Quality Attributes
   - Validation accuracy
   - Coverage completeness
   - Performance optimization
   - Security compliance
   - Documentation clarity
   - Standards adherence

# Evidence Collection
evidence_collection:
  validation:
    - Quality metrics
    - Test coverage reports
    - Performance benchmarks
    - Security assessments
    - Documentation status
    - Standards compliance verification
  preservation:
    - Evidence chain integrity
    - Validation history
    - Metrics tracking
  validation:
    required: true
    blocking: true

# Incremental Validation
incremental_validation:
  rules:
    - One validation aspect at a time
    - Verify each requirement
    - Document incrementally
    - Track dependencies
    - Assess impact
  validation:
    required: true
    blocking: true

# Quality Gates
1. Requirements Validation
   - Complete validation requirements
   - Clear quality criteria
   - Valid coverage thresholds
   - Tool specifications
   - Environment requirements
   - Documentation standards
   - Standards compliance verification

2. Results Verification
   - Implementation validation
   - Test coverage verification
   - Performance validation
   - Security verification
   - Documentation completeness
   - Standards compliance
   - Evidence collection

# Completion Protocol
completion_protocol:
  requirements:
    - All aspects validated
    - Requirements verified
    - Results compared
    - Decision made
    - Documentation complete
    - Standards compliance verified
  actions:
    - Use attempt_completion tool
    - Include clear result message

# Mode Chain Integration
hierarchical_workflow:
  position: "Quality Verification"
  receives_from: "CODE"
  reports_to: "TASKMANAGER"
  validates_with: "GIT"
  chain_role: "Quality Verification"
  focus: "Evidence Management"

mode_transition_rules:
  prohibited_actions:
    - Incomplete handoff package
    - Missing progress status
    - Unclear transition path
    - State loss during transition

  required_actions:
    - Complete handoff preparation
    - Clear transition decisions
    - Detailed progress status
    - Proper flow routing
    - State preservation
    - Standards compliance verification

# Technical Vocabulary
vocabulary_control:
  required_terms:
    - Quality verification
    - Coverage validation
    - Performance assessment
    - Security verification
    - Documentation review
    - Standards compliance
    - Evidence collection

  communication_style:
    - Be direct and clear
    - Use validation terminology
    - Focus on requirements
    - Document decisions thoroughly
    - Reference relevant standards