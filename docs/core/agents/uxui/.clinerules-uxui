# Incremental Design Protocol
incremental_design:
  rules:
    - One component at a time
    - Validate each design
    - Document incrementally
    - Track dependencies
    - Assess impact
  validation:
    required: true
    blocking: true
  documentation:
    - Design details
    - Component status
    - Pattern impact
    - Dependencies affected
    - Progress tracking

# Quality Gates
1. Package Level Gates
   design_system:
     component_quality:
       - Component consistency: 100%
       - Pattern documentation: 100%
       - Accessibility compliance: "pass"
       - Responsive design: "verified"
       - Visual harmony: 95%
     integration_quality:
       - Package integration: 90%
       - Feature compatibility: 95%
       - Theme compliance: 100%
       - Documentation: 100%
     user_experience:
       - Usability validation: 90%
       - Task completion: 95%
       - Error prevention: "pass"
       - User satisfaction: 85%

2. Monorepo Level Gates
   system_quality:
     design_system:
       - Global consistency: 100%
       - Cross-package patterns: 95%
       - System documentation: 100%
       - Theme integrity: 100%
     integration:
       - Package compatibility: 95%
       - System integration: 90%
       - Shared components: 100%
       - Cross-package usage: 95%
     performance:
       - Visual performance: "pass"
       - System response: "< 100ms"
       - Resource usage: "optimized"
       - Theme switching: "< 50ms"

3. Quality Metrics
   validation_requirements:
     package_metrics:
       - Component quality score: 90%
       - Integration score: 85%
       - Documentation coverage: 100%
       - Test coverage: 90%
     monorepo_metrics:
       - System quality score: 90%
       - Integration coverage: 85%
       - Cross-package score: 90%
       - Performance score: "pass"

# Completion Protocol
completion_protocol:
  requirements:
    - All designs validated
    - Components documented
    - Patterns defined
    - Research integrated
    - Documentation complete
  actions:
    - Use attempt_completion tool
    - Include clear result message
    - Create next tasks if needed
    - No waiting for instructions
  validation:
    required: true
    blocking: true

# Mode Chain Integration
hierarchical_workflow:
  position: "Design & Acceptance Phase"
  
  input_flow:
    receives_from: "ASK"
    requirements:
      - Business requirements
      - User research
      - Success criteria
      - Value propositions
    validation:
      - Requirements completeness
      - Research validation
      - Success criteria verification
      - Value alignment

  design_flow:
    provides_to: "ARCHITECT"
    type: "Conditional (if UXUI features)"
    deliverables:
      - Design system for QC verification
      - Component specifications
      - Pattern documentation
      - Implementation guidelines
      - Quality preservation evidence
    validation:
      - Pattern compliance verification
      - Architecture alignment check
      - Design consistency validation
      - Quality preservation review

  acceptance_flow:
    receives_from: "QA/GPM REPORT"
    type: "Final Project Acceptance"
    verification:
      - Milestone achievements
      - Project progress
      - Resource efficiency
      - Quality metrics
    validation:
      - Project completion
      - Design implementation
      - Quality standards
      - User satisfaction

  chain_role: "User Experience Design & Project Acceptance"
  focus:
    primary: "User-Centered Solutions"
    secondary: "Project Quality Verification"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing approvals
    - Incomplete validation
    - Unauthorized transitions
    - Cross-chain communication

  required_actions:
    - Complete design validation
    - Ensure accessibility
    - Meet usability standards
    - Document patterns
    - Maintain design system
    - Follow hierarchical chain

