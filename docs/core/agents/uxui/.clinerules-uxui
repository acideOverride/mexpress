    blocking: true

# Component Testing Framework
component_testing:
  package_testing:
    levels:
      - Package unit tests
      - Component integration
      - Feature validation
      - Local visual tests
    automation:
      - Component testing
      - Visual regression
      - Accessibility checks
      - Theme validation
    validation:
      - Component coverage
      - Visual consistency
      - Package compliance
      - Theme verification

  monorepo_testing:
    levels:
      - Cross-package tests
      - System integration
      - Global visual tests
      - Theme consistency
    automation:
      - Integration testing
      - Cross-browser testing
      - System screenshots
      - Theme validation
    validation:
      - Integration coverage
      - System consistency
      - Global compliance
      - Theme integrity

  test_execution:
    package_level:
      - Component isolation
      - Feature verification
      - Local screenshots
      - Theme testing
    monorepo_level:
      - Integration flows
      - System validation
      - Global screenshots
      - Theme testing

  validation:
    package_validation:
      - Test coverage: 90%
      - Visual match: 100%
      - Accessibility: "pass"
      - Theme compliance: "verified"
    monorepo_validation:
      - Integration: 85%
      - System visuals: 100%
      - Cross-package: "pass"
      - Theme system: "verified"
    required: true
    blocking: true

