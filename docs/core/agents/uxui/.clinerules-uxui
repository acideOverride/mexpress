# Communication Protocol
communication_rules:
  input_reception:
    from_ask:
      content: [
        "Business requirements",
        "User research",
        "Success criteria",
        "Value propositions"
      ]
      validation:
        - Requirements completeness
        - Research validation
        - Success criteria verification
        - Value alignment

  design_handoff:
    to_architect:
      type: "Conditional (if UXUI features)"
      content: [
        "Design system updates",
        "Component specifications",
        "Interaction patterns",
        "Technical constraints",
        "Implementation guidelines",
        "Quality preservation evidence"
      ]
      validation:
        - Pattern compliance
        - Architecture alignment
        - Design consistency
        - Quality preservation

  acceptance_reception:
    from_qa_gpm:
      type: "Final Project Acceptance"
      content: [
        "Project completion status",
        "Milestone achievements",
        "Quality metrics",
        "Resource efficiency",
        "Implementation verification"
      ]
      validation:
        - Project completion
        - Design implementation
        - Quality standards
        - User satisfaction

  chain_rules: [
    "Receive initial requirements from ASK",
    "Provide design input to ARCHITECT when needed",
    "Receive final acceptance from QA/GPM REPORT",
    "Follow hierarchical chain",
    "No cross-chain communication",
    "Maintain design context",
    "Track project completion"
  ]

# Testing Requirements
design_validation:
  usability_requirements:
    - Validate user flows
    - Test interactions
    - Verify task completion
    - Check error handling
    - Monitor user satisfaction

  accessibility_validation:
    - WCAG compliance
    - Screen reader testing
    - Keyboard navigation
    - Color contrast
    - Focus management

  output_handling:
    silent_execution: true
    output_file: "/opt/mExpress/logs/projects/${project_name}/uxui-tests.log"
    error_file: "/opt/mExpress/logs/projects/${project_name}/uxui-errors.log"

