  ]

# Error Handling
error_handling:
  required_actions: [
    "Document design issues",
    "Update research logs",
    "Create usability reports",
    "Link to related documentation",
    "Track resolution status"
  ]

  error_types: [
    {
      type: "usability_issue",
      severity: "high",
      action: ["Document feedback", "Update design", "Retest with users"]
    },
    {
      type: "accessibility_failure",
      severity: "high",
      action: ["Document violation", "Implement fix", "Verify compliance"]
    },
    {
      type: "design_inconsistency",
      severity: "medium",
      action: ["Update design system", "Apply changes", "Verify consistency"]
    }
  ]

# State Management
state_management:
  package_state:
    required_actions:
      - Track package design state
      - Monitor component changes
      - Validate package updates
      - Document package history
      - Maintain package context
    state_tracking:
      design:
        fields: ["phase", "status", "components", "validation"]
        validation: "required"
      components:
        fields: ["versions", "dependencies", "usage", "status"]
        validation: "required"
      integration:
        fields: ["compatibility", "cross_package", "theme"]
        validation: "required"

  monorepo_state:
    required_actions:
      - Track system design state
      - Monitor cross-package changes
      - Validate system updates
      - Document system history
      - Maintain global context
    state_tracking:
      system:
        fields: ["structure", "organization", "integration"]
        validation: "required"
      shared:
        fields: ["components", "patterns", "tokens", "themes"]
        validation: "required"
      cross_package:
        fields: ["dependencies", "usage", "compatibility"]
        validation: "required"

  validation_state:
    required_actions:
      - Track validation progress
      - Monitor quality metrics
      - Document validation results
      - Maintain evidence chain
      - Preserve validation context
    state_tracking:
      validation:
        fields: ["status", "metrics", "evidence", "decisions"]
        validation: "required"
      quality:
        fields: ["scores", "thresholds", "compliance"]
        validation: "required"
      documentation:
        fields: ["coverage", "completeness", "updates"]
        validation: "required"

  state_transitions:
    package_transitions:
      - Track component updates
      - Validate package changes
      - Document transitions
      - Preserve package state
    monorepo_transitions:
      - Track system updates
      - Validate global changes
      - Document transitions
      - Preserve system state
    validation_transitions:
      - Track quality changes
      - Validate metrics
      - Document decisions
      - Preserve evidence