# General Cline Rules v2.0

# Core Configuration
mode: "roo_core"
description: "Core workflow and validation framework with monorepo support"
version: "3.0.0"

# Workflow Structure
workflow:
  # Bidirectional Flow
  downstream_flow:
    requirements:
      - Package-level input validation
      - System-wide chain initialization
      - Cross-package quality context
      - Multi-level state preservation
      - Monorepo context documentation
    validation:
      - Package input completeness
      - System-wide chain integrity
      - Cross-package quality preservation
      - Multi-level state consistency
      - Monorepo context validation

  upstream_flow:
    requirements:
      - Package-level evidence collection
      - System-wide quality verification
      - Cross-package chain maintenance
      - Multi-level state updates
      - Monorepo context preservation
    validation:
      - Package evidence completeness
      - System-wide quality standards
      - Cross-package chain integrity
      - Multi-level state consistency
      - Monorepo context validation

# Chain Management
validation_chain:
  requirements:
    - Package-level chain initialization
    - System-wide evidence collection
    - Cross-package quality preservation
    - Multi-level state management
    - Monorepo documentation maintenance
    - Integration point validation
    - Dependency chain tracking

  verification_points:
    package_level:
      - Package requirements completeness
      - Package research validation
      - Package success criteria
      - Package value alignment
      - Integration readiness

    system_level:
      - System-wide requirements completeness
      - Cross-package research validation
      - System success criteria
      - Portfolio value alignment
      - Resource optimization

    integration_level:
      - Cross-package compatibility
      - Shared resource utilization
      - Integration point validation
      - Dependency management
      - System-wide consistency

    quality:
      - Framework compliance
      - Standards adherence
      - Documentation completeness
      - Evidence preservation
      - Cross-package quality

    state:
      - Package context preservation
      - System context preservation
      - Cross-package chain integrity
      - Multi-level history maintenance
      - Monorepo metrics tracking

# Quality Framework
quality_framework:
  standards:
    package_level:
      - Package quality context
      - Package evidence collection
      - Package chain preservation
      - Package state management
      - Package documentation

    system_level:
      - System-wide quality context
      - Cross-package evidence collection
      - Monorepo chain preservation
      - Multi-level state management
      - System documentation

    integration_level:
      - Cross-package quality standards
      - Integration point validation
      - Dependency management
      - Resource optimization
      - Shared context maintenance

  validation:
    requirements:
      package_level:
        - Package validation chain
        - Package evidence preservation
        - Package quality metrics
        - Package state consistency

      system_level:
        - System-wide validation chain
        - Cross-package evidence preservation
        - System quality metrics
        - Multi-level state consistency

      integration_level:
        - Integration validation chain
        - Cross-package compatibility
        - Integration metrics
        - Resource utilization

    evidence:
      - Package collection points
      - System-wide collection points
      - Integration evidence points
      - Cross-package dependencies
      - Chain preservation at all levels
      - Multi-level context maintenance

# State Management
state_management:
  requirements:
    package_level:
      - Package state initialization
      - Package context preservation
      - Package chain maintenance
      - Package history tracking
      - Package metrics collection

    system_level:
      - System-wide state initialization
      - Cross-package context preservation
      - Monorepo chain maintenance
      - Multi-level history tracking
      - System metrics collection

    integration_level:
      - Integration state management
      - Cross-package dependency tracking
      - Resource state maintenance
      - Shared context preservation
      - Integration metrics collection

  validation:
    package_level:
      - Package state consistency
      - Package context integrity
      - Package chain preservation
      - Package history maintenance
      - Package metrics accuracy

    system_level:
      - System-wide state consistency
      - Cross-package context integrity
      - Monorepo chain preservation
      - Multi-level history maintenance
      - System metrics accuracy

    integration_level:
      - Integration state consistency
      - Cross-package compatibility
      - Resource state integrity
      - Shared context maintenance
      - Integration metrics accuracy

# Mode Transitions
mode_transitions:
  requirements:
    package_level:
      - Package validation chain complete
      - Package quality context preserved
      - Package state properly managed
      - Package documentation complete
      - Package evidence collected

    system_level:
      - System-wide validation chain complete
      - Cross-package quality context preserved
      - Multi-level state properly managed
      - System documentation complete
      - System-wide evidence collected

    integration_level:
      - Integration validation complete
      - Cross-package context preserved
      - Resource state managed
      - Integration documentation complete
      - Integration evidence collected

  validation:
    package_level:
      - Package chain integrity
      - Package context preservation
      - Package state consistency
      - Package documentation completeness
      - Package evidence verification

    system_level:
      - System-wide chain integrity
      - Cross-package context preservation
      - Multi-level state consistency
      - System documentation completeness
      - System-wide evidence verification

    integration_level:
      - Integration chain integrity
      - Cross-package compatibility
      - Resource state consistency
      - Integration documentation completeness
      - Integration evidence verification

# Documentation Standards
documentation:
  requirements:
    package_level:
      - Package documentation coverage
      - Package chain documentation
      - Package evidence preservation
      - Package state tracking
      - Package quality context

    system_level:
      - System-wide documentation coverage
      - Cross-package chain documentation
      - System-wide evidence preservation
      - Multi-level state tracking
      - System quality context

    integration_level:
      - Integration documentation coverage
      - Cross-package relationship documentation
      - Integration evidence preservation
      - Resource state tracking
      - Integration quality context

  validation:
    package_level:
      - Package documentation completeness
      - Package chain integrity
      - Package evidence preservation
      - Package state consistency
      - Package context maintenance

    system_level:
      - System-wide documentation completeness
      - Cross-package chain integrity
      - System-wide evidence preservation
      - Multi-level state consistency
      - System context maintenance

    integration_level:
      - Integration documentation completeness
      - Cross-package relationship integrity
      - Integration evidence preservation
      - Resource state consistency
      - Integration context maintenance

# Evidence Management
evidence:
  collection_points:
    package_level:
      - During package validation
      - After package transitions
      - During package operations
      - After package updates
      - Package integration points

    system_level:
      - During system validation
      - After cross-package transitions
      - During system operations
      - After system updates
      - Cross-package integration points

    integration_level:
      - During integration validation
      - After resource transitions
      - During integration operations
      - After dependency updates
      - Shared resource points

  requirements:
    package_level:
      - Package evidence collection
      - Package chain preservation
      - Package context maintenance
      - Package state tracking
      - Integration evidence

    system_level:
      - System-wide evidence collection
      - Cross-package chain preservation
      - System context maintenance
      - Multi-level state tracking
      - Integration coordination

    integration_level:
      - Integration evidence collection
      - Cross-package dependency tracking
      - Resource context maintenance
      - Integration state tracking
      - Shared resource management

  validation:
    package_level:
      - Package evidence completeness
      - Package chain integrity
      - Package context preservation
      - Package state consistency
      - Integration validation

    system_level:
      - System-wide evidence completeness
      - Cross-package chain integrity
      - System context preservation
      - Multi-level state consistency
      - Integration coordination

    integration_level:
      - Integration evidence completeness
      - Cross-package dependency integrity
      - Resource context preservation
      - Integration state consistency
      - Shared resource validation

# Quality Gates
quality_gates:
  input_validation:
    package_level:
      - Package requirements completeness
      - Package research validation
      - Package success criteria
      - Package value alignment
      - Integration readiness

    system_level:
      - System-wide requirements completeness
      - Cross-package research validation
      - System success criteria
      - Portfolio value alignment
      - Resource optimization

    integration_level:
      - Integration requirements completeness
      - Cross-package compatibility validation
      - Integration success criteria
      - Resource value alignment
      - Dependency optimization

  quality_verification:
    package_level:
      - Package framework compliance
      - Package standards adherence
      - Package documentation completeness
      - Package evidence preservation
      - Integration quality

    system_level:
      - System-wide framework compliance
      - Cross-package standards adherence
      - System documentation completeness
      - System evidence preservation
      - Integration coordination

    integration_level:
      - Integration framework compliance
      - Cross-package compatibility
      - Integration documentation completeness
      - Integration evidence preservation
      - Resource optimization

  state_validation:
    package_level:
      - Package context preservation
      - Package chain integrity
      - Package history maintenance
      - Package metrics tracking
      - Integration state

    system_level:
      - System-wide context preservation
      - Cross-package chain integrity
      - Multi-level history maintenance
      - System metrics tracking
      - Integration coordination

    integration_level:
      - Integration context preservation
      - Cross-package state integrity
      - Resource history maintenance
      - Integration metrics tracking
      - Dependency state

# Success Criteria
success_metrics:
  validation:
    package_level:
      - Package chain completeness
      - Package evidence preservation
      - Package quality maintenance
      - Package state consistency
      - Package documentation coverage

    system_level:
      - System-wide chain completeness
      - Cross-package evidence preservation
      - System quality maintenance
      - Multi-level state consistency
      - System documentation coverage

    integration_level:
      - Integration chain completeness
      - Cross-package evidence preservation
      - Integration quality maintenance
      - Resource state consistency
      - Integration documentation coverage

  requirements:
    package_level:
      - Package validation chain complete
      - Package evidence preserved
      - Package quality maintained
      - Package state consistent
      - Package documentation complete

    system_level:
      - System-wide validation chain complete
      - Cross-package evidence preserved
      - System quality maintained
      - Multi-level state consistent
      - System documentation complete

    integration_level:
      - Integration validation chain complete
      - Cross-package evidence preserved
      - Integration quality maintained
      - Resource state consistent
      - Integration documentation complete

# Error Handling
error_handling:
  requirements:
    package_level:
      - Package error documentation
      - Package chain preservation
      - Package state recovery
      - Package evidence collection
      - Package context maintenance

    system_level:
      - System-wide error documentation
      - Cross-package chain preservation
      - Multi-level state recovery
      - System evidence collection
      - System context maintenance

    integration_level:
      - Integration error documentation
      - Cross-package dependency preservation
      - Resource state recovery
      - Integration evidence collection
      - Integration context maintenance

  validation:
    package_level:
      - Package error resolution
      - Package chain integrity
      - Package state consistency
      - Package evidence completeness
      - Package context preservation

    system_level:
      - System-wide error resolution
      - Cross-package chain integrity
      - Multi-level state consistency
      - System evidence completeness
      - System context preservation

    integration_level:
      - Integration error resolution
      - Cross-package dependency integrity
      - Resource state consistency
      - Integration evidence completeness
      - Integration context preservation

# File Permissions
edit_permissions:
  allowed_extensions:
    - .md
    - .json
    - .yaml
    - .yml
  restricted_paths:
    - /opt/mExpress/docs/