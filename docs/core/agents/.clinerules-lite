# General Cline Rules - Lite v1.0

# Core Configuration
mode: "roo_core"
description: "Core workflow and validation framework with monorepo support"
version: "3.0.0-lite"

# Standards References
standards_references:
  - Architecture Standards: /opt/mExpress/docs/core/standards/B_architecture.md
  - Development Principles: /opt/mExpress/docs/core/standards/C_development_principles.md
  - Frontend Standards: /opt/mExpress/docs/core/standards/C1_frontend_development_standards.md
  - Backend Standards: /opt/mExpress/docs/core/standards/C2_backend_development_standards.md
  - API Standards: /opt/mExpress/docs/core/standards/C3_api_development_standards.md
  - Test Standards: /opt/mExpress/docs/core/standards/C4_test_standards.md
  - Quality & Security: /opt/mExpress/docs/core/standards/D_quality_security.md

# Workflow Structure
workflow:
  # Bidirectional Flow
  downstream_flow:
    requirements:
      - Package-level input validation
      - Quality context initialization
      - State preservation
      - Documentation completeness
      - Standards compliance

    validation:
      - Input completeness
      - Quality preservation
      - State consistency
      - Standards compliance verification

  upstream_flow:
    requirements:
      - Evidence collection
      - Quality verification
      - State updates
      - Documentation maintenance
      - Standards compliance verification

    validation:
      - Evidence completeness
      - Quality standards verification
      - State consistency
      - Standards compliance

# Chain Management
validation_chain:
  requirements:
    - Chain initialization
    - Evidence collection
    - Quality preservation
    - State management
    - Documentation maintenance
    - Standards compliance

  verification_points:
    - Requirements completeness
    - Quality compliance
    - Success criteria validation
    - Standards adherence
    - Value alignment
    - Documentation completeness

# Quality Framework
quality_framework:
  standards:
    - Quality context maintenance
    - Evidence collection
    - Chain preservation
    - State management
    - Documentation completeness
    - Standards compliance

  validation:
    - Validation chain integrity
    - Evidence preservation
    - Quality metrics tracking
    - State consistency
    - Documentation completeness
    - Standards compliance verification

# State Management
state_management:
  requirements:
    - State initialization
    - Context preservation
    - Chain maintenance
    - History tracking
    - Metrics collection
    - Standards compliance

  validation:
    - State consistency
    - Context integrity
    - Chain preservation
    - History maintenance
    - Metrics accuracy
    - Standards compliance verification

# Mode Transitions
mode_transitions:
  requirements:
    - Validation chain completion
