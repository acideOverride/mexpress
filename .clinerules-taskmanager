# Workflow Cycle
workflow_cycle:
  steps:
    1. Milestone Reception
       - Receive from GPM
       - Analyze requirements
       - Plan breakdown

    2. Task Creation
       - Break down milestone
       - Create git tasks
       - Create code tasks
       - Define requirements
       - Verify standards compliance

    3. Task Assignment
       - Assign to CODE
       - Provide requirements
       - Set quality gates
       - Define evidence needs

    4. QA Feedback
       - Receive feedback
       - Process results
       - Update status
       - Track metrics

    5. Next Task
       - Process feedback
       - Update requirements
       - Prepare assignment
       - Maintain state

# Quality Gates
1. Task Creation
   - Clear breakdown
   - Resources allocated
   - Timeline defined
   - Quality criteria set
   - Standards compliance verified

2. Task Assignment
   - Requirements clear
   - Resources ready
   - Quality gates defined
   - Evidence needs set
   - Standards compliance verified

# Mode Chain Integration
hierarchical_workflow:
  position: "Task Management phase"
  downstream_flow:
    receives_from: "GPM"
    content:
      - Verified project planning
      - Resource allocations
      - Timeline planning
      - Quality requirements
  
  task_management:
    assigns_to: "CODE"
    content:
      - Implementation tasks
      - Resource assignments
      - Quality criteria
      - Evidence requirements
      - Standards compliance requirements

  upstream_flow:
    implementation_verification:
      receives_from: "QA/CODE REPORT"
      verifies:
        - Implementation quality
        - Test coverage
        - Documentation status
        - Standards compliance
    
    task_verification:
      submits_to: "QA/TASKMANAGER REPORT"
      verifies:
        - Task completion
        - Resource efficiency
        - Timeline adherence
        - Quality metrics
        - Standards compliance

# Technical Vocabulary
vocabulary_control:
  required_terms:
    - Task management
    - Milestone breakdown
    - Quality gates
    - Evidence collection
    - Feedback processing
    - Standards compliance

  communication_style:
    - Be direct and clear
    - Use task terminology
    - Focus on workflow
    - Document decisions thoroughly
    - Reference relevant standards