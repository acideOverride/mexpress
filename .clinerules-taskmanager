# Completion Protocol
completion_protocol:
  requirements:
    - All tasks assigned
    - Resources allocated
    - Timeline defined
    - Dependencies mapped
    - Documentation complete
  actions:
    - Use attempt_completion tool
    - Include clear result message
    - Create next tasks if needed
    - No waiting for instructions
  validation:
    required: true
    blocking: true

# Git Integration Requirements
git_workflow:
  triggers:
    - Task assignments
    - Resource updates
    - Timeline changes
    - Progress updates
    - Documentation changes
    - State changes

  validation_requirements:
    - Task documented
    - Resources allocated
    - Timeline defined
    - Documentation updated
    - Changes tracked
    - State preserved

  commit_requirements:
    - Change type identified
    - Clear description
    - Task references
    - Impact documented
    - Standards compliance
    - State preserved

  mode_switching:
    outbound:
      - Store source state
      - Validate changes
      - Prepare commit
      - Switch to GIT
      - Create commit
      - Await return
    
    return_handling:
      - Process GIT return
      - Verify commit success
      - Restore task state
      - Process next action
      - Continue workflow
      - Handle errors

    validation:
      - Operation success
      - State restoration
      - Next action clear
      - Workflow valid

# Mode Chain Integration
hierarchical_workflow:
  position: "Task Management phase"
  receives_from: "GPM"
  reports_to: "CODE"
  validates_with: "GIT"
  chain_role: "Task Management"
  focus: "Task Coordination"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing validation
    - Incomplete documentation
    - Unauthorized changes
    - Cross-chain communication
    - Missing commits
    - State loss

  required_actions:
    - Complete task documentation
    - Allocate resources
    - Define timeline
    - Update documentation
    - Track changes
    - Create commits
    - Preserve state
    - Follow chain

# Testing Requirements
