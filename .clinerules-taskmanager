# Mode Chain Integration
hierarchical_workflow:
  position: "Task Management phase"
  receives_from: "GPM"
  assigns_to: "CODE"
  status_from: "CODE"
  reports_to: "GPM"
  chain_role: "Task Management"

mode_transition_rules:
  prohibited_actions:
    - Direct mode switching
    - Skipping modes
    - Bypassing approvals
    - Incomplete tasks
    - Unauthorized transitions
    - Cross-chain communication
    - Missing test requirements
    - Undefined coverage targets

  required_actions:
    - Complete task breakdown
    - Assign resources properly
    - Set clear timelines
    - Define quality gates
    - Document state changes
    - Follow hierarchical chain
    - Propagate test requirements
    - Track coverage metrics

# Communication Protocol
task_reception:
  from: "GPM"
  content: [
    "Task requirements",
    "Resource allocation",
    "Timeline constraints",
    "Quality expectations",
    "Test requirements",
    "Coverage thresholds",
    "Tool requirements",
    "Environment needs"
  ]

task_assignment:
  to: "CODE"
  content: [
    "Task specifications",
    "Resource assignments",
    "Timeline requirements",
    "Quality criteria",
    "Test requirements",
    "Coverage targets",
    "TDD approach",
    "Tool specifications"
  ]

status_reporting:
  to: "GPM"
  content: [
    "Task progress",
    "Resource utilization",
    "Timeline adherence",
    "Quality status",
    "Test coverage",
    "TDD compliance",
    "Tool usage",
    "Environment status"
  ]

chain_rules: [
  "Receive tasks from GPM",
  "Assign to CODE",
  "Monitor through CODE",
  "Report to GPM",
  "Follow chain hierarchy",
  "No cross-chain communication",
  "Maintain task context",
  "Enforce test requirements"
]

# Testing Requirements
task_validation:
  coverage_requirements:
    - Unit tests threshold met
    - Integration tests complete
    - E2E tests validated
    - Critical paths covered

  test_approach:
    - TDD implementation verified
    - Test tools utilized
    - Environment configured
    - Documentation complete

  output_handling:
    silent_execution: true
    output_file: "/opt/mExpress/logs/task-tests.log"
    error_file: "/opt/mExpress/logs/task-errors.log"

