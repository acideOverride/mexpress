# State Management
state_management:
  required_actions:
    - Track task state
    - Monitor assignments
    - Document changes
    - Preserve git context
    - Manage transitions
    - Handle errors
    - Maintain history
    - Enable recovery

  state_tracking:
    source:
      fields: ["agent", "status", "next_action", "workflow"]
      validation: "required"
      preservation: "mandatory"
    tasks:
      fields: ["status", "resources", "timeline", "return_readiness"]
      validation: "required"
    assignments:
      fields: ["allocation", "progress", "documentation"]
      validation: "required"
    git:
      fields: ["changes", "commit", "state", "return_status", "next_action"]
      validation: "required"
    return:
      fields: ["status", "next_action", "workflow", "state_package"]
      validation: "required"
      preservation: "mandatory"