{
  "name": "jerome-bikes",
  "version": "0.1.0",
  "description": "Intelligent bike rental management system for Jerome Bikes",
  "main": "index.js",
  "scripts": {
    "build": "vue-tsc && vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "clean": "rimraf dist",
    "test": "jest",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "dev": "vite",
    "dev:backend": "cross-env NODE_ENV=development nodemon --exec ts-node src/backend/server.ts",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "start": "node dist/backend/server.js",
    "db:seed": "ts-node src/backend/scripts/seed.ts",
    "db:reset": "ts-node src/backend/scripts/reset-db.ts",
    "test:p0": "cross-env PRIORITY=p0 jest",
    "test:p1": "cross-env PRIORITY=p1 jest",
    "test:p2": "cross-env PRIORITY=p2 jest",
    "test:p3": "cross-env PRIORITY=p3 jest",
    "test:api": "cross-env NODE_ENV=test jest --testPathPattern=src/backend/tests",
    "test:ui": "cross-env NODE_ENV=test jest --testPathPattern=src/frontend/tests --testEnvironment=jsdom"
  },
  "dependencies": {
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vuex": "^4.1.0",
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "redis": "^4.6.7",
    "axios": "^1.4.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "bcrypt": "^5.1.0",
    "winston": "^3.10.0",
    "morgan": "^1.10.0",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "mongodb-memory-server": "^8.15.1",
    "ioredis": "^5.3.2",
    "connect-redis": "^7.1.0",
    "express-session": "^1.17.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "express-rate-limit": "^7.1.1",
    "http-status-codes": "^2.2.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.3",
    "@types/cookie-parser": "^1.4.4",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.17",
    "@types/express-session": "^1.17.8",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.5",
    "@types/supertest": "^2.0.14",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.4.1",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-vue": "^9.15.1",
    "jest": "^29.6.1",
    "jest-environment-jsdom": "^29.6.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vite": "^4.4.7",
    "vue-tsc": "^1.8.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerome-bikes/jerome-bikes.git"
  },
  "keywords": [
    "bike",
    "rental",
    "vue",
    "mongodb",
    "express",
    "typescript"
  ],
  "author": "Jerome Bikes Team",
  "license": "UNLICENSED",
  "private": true
}