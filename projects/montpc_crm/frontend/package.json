{
  "name": "montpc_crm-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:react": "vite",
    "dev:vue": "vite --config vite.vue.config.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bash tests/run-tests.sh",
    "test:p0": "NODE_OPTIONS='--max-old-space-size=512' jest --config tests/jest.config.js --testMatch '**/p0/**/*.test.{ts,tsx}' --silent > tests/results/p0/test.log 2>/dev/null",
    "test:p1": "NODE_OPTIONS='--max-old-space-size=1024' jest --config tests/jest.config.js --testMatch '**/p1/**/*.test.{ts,tsx}' --silent > tests/results/p1/test.log 2>/dev/null",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=1024' jest --config tests/jest.config.js --coverage --silent > tests/results/summary/coverage.log 2>/dev/null",
    "test:vue": "vitest run",
    "test:vue:watch": "vitest"
  },
  "dependencies": {
    "@vue/devtools-api": "^6.5.1",
    "@vue/runtime-dom": "^3.3.4",
    "axios": "^1.6.0",
    "pinia": "^2.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.18.0",
    "vue": "^3.3.4",
    "vue-demi": "^0.14.6",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.66.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.6",
    "@types/node": "^20.8.10",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/test-utils": "^2.4.4",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.7.3",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^1.3.1",
    "vue-tsc": "^1.8.27"
  }
}
