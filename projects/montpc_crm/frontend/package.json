{
  "name": "montpc_crm-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --config vite.vue.config.ts",
    "build": "vue-tsc && vite build --config vite.vue.config.ts",
    "preview": "vite preview --config vite.vue.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf node_modules/.vite && rm -rf node_modules/.cache"
  },
  "dependencies": {
    "axios": "1.6.0",
    "vue": "3.2.47",
    "vue-router": "4.1.6"
  },
  "devDependencies": {
    "@types/node": "20.8.10",
    "@vitejs/plugin-vue": "4.0.0",
    "typescript": "5.0.2",
    "vite": "4.3.9",
    "vitest": "0.32.0",
    "vue-tsc": "1.6.5"
  }
}
