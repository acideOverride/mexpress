{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noImplicitAny": false,
    "allowJs": true,
    "lib": ["ES2020"],
    "outDir": "./dist",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"]
  },
  "include": [
    "api-server.ts"
  ],
  "exclude": [
    "node_modules",
    "frontend",
    "dist"
  ]
}