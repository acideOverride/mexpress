{
  "name": "mexpress-core",
  "version": "1.0.0",
  "description": "mExpress Core Services",
  "main": "dist/index.js",
  "scripts": {
    "test": "jest --silent > logs/test-status.log",
    "test:watch": "jest --silent --watch",
    "test:coverage": "jest --silent --coverage --coverageReporters=\"text-summary\" > logs/coverage-summary.log",
    "test:ci": "jest --silent --coverage --coverageReporters=\"text-summary\" --ci > logs/test-status.log 2> logs/test-errors.log",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.17",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.3",
    "uuid": "^11.0.5"
  }
}
