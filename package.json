{
  "name": "mexpress-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "projects/*"
  ],
  "scripts": {
    "build": "lerna run build --stream",
    "test": "jest --config tests/jest.config.js",
    "test:packages": "jest --config tests/jest.packages.config.js",
    "test:projects": "jest --config tests/jest.projects.config.js",
    "test:core": "jest --config tests/packages/core/jest.config.js",
    "test:ui": "jest --config tests/packages/ui-components/jest.config.js",
    "test:utils": "jest --config tests/packages/utils/jest.config.js",
    "test:montpc:frontend": "jest --config tests/projects/montpc_crm/frontend/jest.config.js",
    "test:unit": "jest --testPathPattern=\"unit/\" --config tests/jest.config.js",
    "test:integration": "jest --testPathPattern=\"integration/\" --config tests/jest.config.js",
    "lint": "lerna run lint --stream",
    "clean": "lerna clean",
    "bootstrap": "lerna bootstrap",
    "version": "lerna version",
    "publish": "lerna publish",
    "test:dashboard": "bash ./run-tests-with-dashboard.sh",
    "update:dashboard": "node /opt/mExpress/dashboard/unified/test-collector.js && node /opt/mExpress/dashboard/unified/update-dashboard.js"
  },
  "devDependencies": {
    "@sinonjs/referee-sinon": "^12.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/commander": "^2.12.5",
    "axios-mock-adapter": "^2.1.0",
    "crypto": "^1.0.1",
    "glob": "^11.0.1",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jsverify": "^0.8.4",
    "lerna": "^7.0.0",
    "marked": "^15.0.7",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^13.1.0"
  }
}
