{
  "compilerOptions": {
    "baseUrl": "../../../",
    "paths": {
      "@mexpress/core/*": ["packages/core/src/*"],
      "@mexpress/ui/*": ["packages/ui-components/src/*"],
      "@mexpress/utils/*": ["packages/utils/src/*"],
      "@/*": ["packages/core/src/*"]
    },
    "target": "es2020",
    "module": "commonjs",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["jest", "node"],
    "rootDir": "../../../"
  },
  "include": [
    "../../../packages/core/src/**/*",
    "./**/*.ts",
    "./**/*.tsx",
    "../../../tests/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
